    "import re as r \n",
    "string = input(\"Enter a string: \")\n",
    "if r.fullmatch(r'[a-zA-Z0-9]+', string):\n",
    "    print(\"String contains only a-z A-Z 0-9\")\n",
    "else:\n",
    "   print(\"String contains other characters\") "
